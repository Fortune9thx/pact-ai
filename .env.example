# GenLayer RPC endpoint
# Studionet (local): http://localhost:4000/api/rpc  (from genlayer studio)
# Testnet Bradbury:  https://rpc.testnet.genlayer.com
NEXT_PUBLIC_GENLAYER_RPC_URL=http://localhost:4000/api/rpc

# Network: "studionet" | "bradbury"
NEXT_PUBLIC_NETWORK=studionet

# Deployed VibeCheck contract address (from deploy/deploy.ts output)
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# Set to "true" to enable demo mode (auto-connects with DEMO_KEY, no MetaMask required)
NEXT_PUBLIC_DEMO_MODE=true

# Demo wallet private key — studionet only, no real funds.
# Generates a deterministic address used for all write transactions in demo mode.
# Leave blank to require MetaMask for all transactions.
# SECURITY: only ever use a brand-new disposable testnet key here. NEXT_PUBLIC_*
# values are inlined into the browser bundle, so this key is effectively public.
NEXT_PUBLIC_DEMO_KEY=0x...

# Deployer private key — used by deploy/deploy.ts and scripts/*.mjs only, never exposed to the browser.
# SECURITY: use a BRAND-NEW wallet from a new seed phrase. The previous key was leaked
# via committed scripts/ files; that wallet (0xbbe0bf...6aa2) is permanently burned.
DEPLOYER_KEY=0x...
